{
  "name": "iobroker.teslemetry",
  "version": "0.2.5",
  "description": "ioBroker adapter for Tesla vehicle and energy site control via Teslemetry",
  "author": {
    "name": "Teslemetry",
    "email": "hello@teslemetry.com"
  },
  "homepage": "https://github.com/Teslemetry/ioBroker.teslemetry",
  "license": "Apache-2.0",
  "keywords": [
    "ioBroker",
    "tesla",
    "teslemetry",
    "smart-home",
    "vehicle",
    "energy",
    "powerwall",
    "iot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Teslemetry/ioBroker.teslemetry.git"
  },
  "bugs": {
    "url": "https://github.com/Teslemetry/ioBroker.teslemetry/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "scripts": {
    "build": "tsdown src/main.ts lib/*.ts --format cjs --target node20 --clean --outDir build",
    "watch": "tsdown src/main.ts lib/*.ts --format cjs --target node20 --watch --outDir build",
    "test": "tsx --test test/*.test.ts",
    "test:unit": "tsx --test test/*.test.ts",
    "test:package": "tsx --test test/packageVersionParity.test.ts",
    "test:integration": "echo 'No @iobroker/testing integration harness configured for this adapter yet'",
    "coverage": "nyc npm test",
    "lint": "oxlint .",
    "check": "tsc --noEmit"
  },
  "main": "build/src/main.cjs",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1",
    "@teslemetry/api": "^0.11.3"
  },
  "devDependencies": {
    "@iobroker/testing": "^5.2.2",
    "@types/node": "^22.10.2",
    "nyc": "^17.1.0",
    "oxlint": "^1.73.0",
    "tsdown": "^0.22.4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
